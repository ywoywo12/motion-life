# Copy to .env (never commit .env). All values below are examples.
ML_ENV=development                      # development | production
DATABASE_URL=postgresql://ml_app:CHANGE_ME@localhost:5432/motionlife
TEST_DATABASE_URL=postgresql://ml_app:CHANGE_ME@localhost:5432/motionlife_test
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
COOKIE_SECURE=0                        # 1 in production (HTTPS only)
PUBLIC_ORIGIN=                         # e.g. https://clinic.example.com (CSRF origin check)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
UPLOAD_DIR=./var/uploads               # outside the web root; include in backups
MAX_UPLOAD_MB=10
CENTER_ADDRESS=دمشق - الميدان
CENTER_PHONE=
PDF_ENGINE=chromium                    # chromium | none (none = HTML preview + browser print)
DB_POOL_SIZE=8
